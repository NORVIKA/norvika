{
  "name": "norvika-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Studio Sanity de norvika.ca (projet k99pdqd1). Dossier à part : le site ne l'importe jamais, et ses paquets ne ralentissent aucune publication du site.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "sanity dev --port 3343",
    "build": "sanity build",
    "deploy": "bash scripts/deployer.sh",
    "typecheck": "tsc --noEmit",
    "valider": "sanity schema validate",
    "verifier-aide": "sanity exec scripts/verifier-aide.ts",
    "semer": "sanity exec scripts/semer.ts --with-user-token"
  },
  "dependencies": {
    "@sanity/icons": "5.3.0",
    "@sanity/locale-fr-fr": "1.2.37",
    "@sanity/ui": "4.4.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.23.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
