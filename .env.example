# Variables publiques (exposées au navigateur, publiques par design).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secrets — côté serveur uniquement. NE JAMAIS préfixer NEXT_PUBLIC_.
# En production : définis dans les variables du projet Cloudflare Pages,
# jamais dans le repo.
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=

# Deploy Hook Cloudflare Pages — déclenche un redéploiement après une
# sauvegarde de contenu dans /admin (auto-publication ISR). Secret.
# À créer dans : Pages > (projet) > Settings > Builds & deployments > Deploy hooks.
CLOUDFLARE_DEPLOY_HOOK_URL=
