# Variables publiques (exposées au navigateur, publiques par design).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Contenu du site : Sanity (projet de Norvika). Lecture publique, aucun jeton.
# Facultatives : lib/sanity.ts retombe sur k99pdqd1 / production si elles manquent.
NEXT_PUBLIC_SANITY_PROJECT_ID=k99pdqd1
NEXT_PUBLIC_SANITY_DATASET=production

# Secrets — côté serveur uniquement. NE JAMAIS préfixer NEXT_PUBLIC_.
# En production : définis dans les variables du projet Cloudflare Pages,
# jamais dans le repo.
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
